# Server configuration
PORT=5000
NODE_ENV=development

# Database configuration (Choose separate parameters OR a unified URL string)
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=chat_app
# DB_SSL=false

# Unified MySQL Connection String (Highly recommended for Railway/Render)
DATABASE_URL=mysql://root:password@localhost:3306/chat_app

# Security secrets (Use a secure strong random string in production)
JWT_SECRET=your_jwt_secret_key

# Configurable CORS Origin (Set to your Vercel frontend URL in production, e.g., https://chat-app.vercel.app)
FRONTEND_URL=*

# Cloudinary Integration (Required for persistent media storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
